// Docusaurus 3 still defines baseUrl, removed in TypeScript 7.
// Keep its supported options here, with paths relative to this site.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": [
        "./*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/",
    "docusaurus.config.ts",
    "sidebars.ts"
  ],
  "exclude": [
    ".docusaurus",
    "build"
  ]
}
