{
  "name": "omnitron-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Omnitron documentation and reference Lumen site",
  "scripts": {
    "start": "lumen dev",
    "build": "xec run scripts/build.js",
    "serve": "lumen serve",
    "typecheck": "tsc6 --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:routes": "node scripts/check-routes.js",
    "docs:api": "node scripts/build-api-index.mjs",
    "check:api": "node scripts/build-api-index.mjs --check",
    "test:browser": "playwright test --workers=1"
  },
  "dependencies": {
    "@omnitron-dev/lumen": "0.4.8",
    "@omnitron-dev/lumen-ast": "0.4.8",
    "@omnitron-dev/lumen-ui": "0.4.8",
    "@omnitron-dev/prism": "0.4.8",
    "apexcharts": "8.8.1",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-apexcharts": "2.2.0",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xec-sh/cli": "0.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module"
}
