{
  "name": "omnitron-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Omnitron documentation and reference Lumen site",
  "scripts": {
    "start": "lumen dev",
    "build": "xec run scripts/build.js",
    "serve": "lumen serve",
    "typecheck": "tsc6 --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:routes": "node scripts/check-routes.js",
    "docs:api": "node scripts/build-api-index.mjs",
    "check:api": "node scripts/build-api-index.mjs --check",
    "test:browser": "playwright test tests/site.spec.js --workers=1"
  },
  "dependencies": {
    "@omnitron-dev/lumen": "0.4.6",
    "@omnitron-dev/lumen-ui": "0.4.6",
    "@omnitron-dev/prism": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xec-sh/cli": "0.11.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module"
}
